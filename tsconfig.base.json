{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2023"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["packages/*/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
	"exclude": [
		"**/node_modules/**",
		"**/.pi/**",
		"**/dist/**",
		"packages/pi-subagents/test/**"
	]
}
