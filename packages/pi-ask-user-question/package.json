{
	"name": "@schovest/pi-ask-user-question",
	"version": "0.1.3",
	"description": "Pi extension. A structured questionnaire the model can put to you when it would otherwise guess, with typed options instead of free-form replies.",
	"type": "module",
	"types": "./index.ts",
	"exports": {
		".": {
			"types": "./index.ts",
			"import": "./index.ts",
			"default": "./index.ts"
		},
		"./events": {
			"types": "./events.ts",
			"import": "./events.ts",
			"default": "./events.ts"
		}
	},
	"license": "MIT",
	"author": "juicesharp",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi"
	],
	"files": [
		"ask-user-question.ts",
		"rpc-fallback.ts",
		"config.ts",
		"events.ts",
		"index.ts",
		"reconcile.ts",
		"LICENSE",
		"locales/",
		"docs/",
		"README.md",
		"state/build-questionnaire.ts",
		"state/external-editor.ts",
		"state/i18n-bridge.ts",
		"state/key-router.ts",
		"state/questionnaire-session.ts",
		"state/row-intent.ts",
		"state/selectors/contract.ts",
		"state/selectors/derivations.ts",
		"state/selectors/focus.ts",
		"state/selectors/projections.ts",
		"state/state-reducer.ts",
		"state/state.ts",
		"tool/format-answer.ts",
